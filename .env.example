# OpenAI Configuration (default)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenRouter Configuration (optional - set USE_OPENROUTER=true to enable)
# The selected model is configured in src/constants/chatbot.ts
# Note: Free models have rate limits (~10-20 requests/minute)
USE_OPENROUTER=true
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Chatbot Configuration
ENABLE_CHATBOT=true

# Site Configuration (for OpenRouter referer header)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact Form
RESEND_API_KEY=re-your-resend-api-key-here
CONTACT_FORM_SECRET=replace-with-a-random-secret-at-least-32-characters

# Environment
NODE_ENV=development
